GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional search-only override; leave blank to use GEMINI_MODEL.
GEMINI_SEARCH_MODEL=
SERPER_API_KEY=
SEARCH_PROVIDER=serper
# Optional; set to gemini only when Gemini Grounding should be used after Serper fails.
SEARCH_FALLBACK_PROVIDER=
SEARCH_CACHE_TTL_MS=600000
GEMINI_TIMEOUT_MS=15000
GEMINI_TTS_TIMEOUT_MS=8000
GEMINI_SEARCH_TIMEOUT_MS=45000
FAHIMA_DIAGNOSTICS=1

AGENT_RECENT_MESSAGE_LIMIT=8
AGENT_CONTEXT_TOKEN_BUDGET=6000
AGENT_TASK_TIMEOUT_MS=300000
AGENT_TASK_LEASE_MS=30000
# Optional model pricing in your account currency per 1M tokens. Leave 0 when unknown.
GEMINI_INPUT_COST_PER_MILLION=0
GEMINI_OUTPUT_COST_PER_MILLION=0

PORT=3000
DB_PATH=./data/fahima.sqlite
FAHIMA_RESERVE_GUIDANCE=اقترحي الاحتياطي من واقع المشروع والمخاطر والتكاليف المعروفة فقط، واكتبي أساسه؛ عند نقص البيانات اتركيه غير محسوم.
